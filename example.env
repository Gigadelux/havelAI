# Copy to .env and fill in. Never commit .env or real values.

# --- Labeler: Jev decision model via OpenRouter (model/train/enhance_pipeline.py) ---
OPENROUTER_API_KEY=
# Pin a version so labels are reproducible. Avoid ~typesafe/jev-latest.
OPENROUTER_MODEL=typesafe/jev-1.14
OPENROUTER_BASE_URL=https://openrouter.ai

# --- Hugging Face (optional, for dataset and model downloads) ---
HF_TOKEN=

# --- RunPod training (model/train/runpod_launch.py, see docs/TRAINING.md) ---
# The API key stays on this machine; it is never put in the pod's environment.
RUNPOD_API_KEY=
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090
RUNPOD_GPU_COUNT=1
# SECURE | COMMUNITY | ALL
RUNPOD_CLOUD_TYPE=SECURE
# Pin a tag, never :latest. torch comes from uv.lock; the image only provides Python and sshd.
RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
# Container disk: venv with torch/CUDA, model, data, checkpoints. No persistent volume is used.
RUNPOD_CONTAINER_DISK_GB=30
# Placement minimums per GPU, NOT caps: RunPod picks a host with at least this much.
RUNPOD_MIN_RAM_GB=16
RUNPOD_MIN_VCPU=4
# Host CUDA versions to accept (torch 2.15 from PyPI needs a CUDA 13 driver). Empty: no filter.
RUNPOD_ALLOWED_CUDA=13.0,13.1,13.2
# Optional, e.g. EU-RO-1
RUNPOD_DATA_CENTER=
# Optional network volume id. It holds only download caches (uv, pip, Hugging Face), so new pods
# skip the ~3.5 GB package download. Billed monthly. Needs RUNPOD_DATA_CENTER = its data center.
RUNPOD_NETWORK_VOLUME_ID=
# Training is stopped after this many hours (the pod keeps billing until it is terminated).
RUNPOD_MAX_HOURS=6
# A pod with a higher hourly rate is terminated right after creation.
RUNPOD_MAX_HOURLY_USD=1.00
# Optional: your own private SSH key. Empty: the launcher creates gitignore/temp/runpod_ed25519
# on the first --yes and uses it only for RunPod. Only the .pub is sent to the pod.
RUNPOD_SSH_KEY=

# --- Training memory (the launcher passes these to train.py as flags) ---
# Lower TRAIN_BATCH_SIZE and raise TRAIN_GRAD_ACCUM to keep the effective batch with less memory.
TRAIN_BATCH_SIZE=16
TRAIN_EVAL_BATCH_SIZE=32
TRAIN_GRAD_ACCUM=1
TRAIN_MAX_LENGTH=512
# 1: recompute activations in the backward pass (less GPU memory, slower steps)
TRAIN_GRADIENT_CHECKPOINTING=0
# Sent to the pod; reduces CUDA memory fragmentation.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
